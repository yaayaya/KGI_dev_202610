  "components": {
    "schemas": {
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "InterestBatchDetailResponse": {
        "required": [
          "batch",
          "calculatedAmt",
          "details"
        ],
        "type": "object",
        "properties": {
          "batch": {
            "description": "本次查詢的批次狀態。",
            "$ref": "#/components/schemas/InterestBatchResponse"
          },
          "calculatedAmt": {
            "type": [
              "null",
              "string"
            ],
            "description": "已提交明細總額（元），固定四位小數；未成功時為 null。"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InterestDetailResponse"
            },
            "description": "已成功提交的合約利息明細；未成功時為空集合。"
          }
        },
        "description": "選定批次的監控快照及已提交明細；處理中不讀取未提交帳務。"
      },
      "InterestBatchResponse": {
        "required": [
          "batchId",
          "expectedAmt",
          "processStatus",
          "progressRate",
          "startedTime",
          "finishedTime",
          "errorMessage"
        ],
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "description": "批次編號，最多二十個字元。"
          },
          "expectedAmt": {
            "type": "string",
            "description": "預計總額（元），固定四位小數，獨立於本次計算結果。"
          },
          "processStatus": {
            "enum": [
              0,
              1,
              2,
              9
            ],
            "type": "integer",
            "description": "批次狀態：0 待處理、1 處理中、2 成功、9 失敗。",
            "format": "int32"
          },
          "progressRate": {
            "type": "integer",
            "description": "處理進度（0–100）；只有成功提交後為 100。",
            "format": "int32"
          },
          "startedTime": {
            "type": [
              "null",
              "string"
            ],
            "description": "UTC ISO 8601 時間；尚未開始或結束時為 null。",
            "format": "date-time"
          },
          "finishedTime": {
            "type": [
              "null",
              "string"
            ],
            "description": "UTC ISO 8601 時間；尚未開始或結束時為 null。",
            "format": "date-time"
          },
          "errorMessage": {
            "type": [
              "null",
              "string"
            ],
            "description": "可呈現的失敗日誌；沒有失敗時為 null，不含連線或系統機密。"
          }
        },
        "description": "利息批次的監控快照，金額以四位小數字串傳輸。"
      },
      "InterestDetailResponse": {
        "required": [
          "detailId",
          "contractNo",
          "dailyInterest"
        ],
        "type": "object",
        "properties": {
          "detailId": {
            "type": "integer",
