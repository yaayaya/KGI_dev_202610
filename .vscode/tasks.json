{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "建置 KGI API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Kgi.Api/Kgi.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "安裝 KGI 前端套件",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": ["ci", "--no-audit", "--no-fund"],
      "options": {
        "cwd": "${workspaceFolder}/Kgi.Web"
      },
      "problemMatcher": []
    }
  ]
}
